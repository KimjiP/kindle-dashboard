# Copy this file to .env and fill it in. .env is never committed to git.
# Google Calendar: Settings > your calendar > Integrate calendar > Secret address in iCal format
CALENDAR_URL=
# Departures from Entur. STOPS: stop place IDs, comma-separated (like NSR:StopPlace:12345).
# Find them with Entur's geocoder: https://api.entur.io/geocoder/v1/autocomplete?text=Jernbanetorget&layers=venue
STOPS=
# ROUTES: the rows to show, as "line destination", comma-separated. Like: 1 Frognerseteren, 31 Snarøya
ROUTES=
